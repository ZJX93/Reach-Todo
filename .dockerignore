# ---- 版本控制 & 编辑器 ----
.git
.gitignore
.vscode
.idea

# ---- 前端构建中间物（容器内会重新构建）----
frontend/node_modules
frontend/dist

# ---- 后端本地构建产物 & 运行时文件（容器内会重新生成）----
backend/static
backend/*.db
backend/.jwt_secret

# ---- Python 缓存 ----
**/__pycache__
**/*.pyc
**/.venv
**/venv

# ---- 密钥 & 环境 ----
.env
.env.*
*.local

# ---- 文档 & 测试（无需进生产镜像）----
**/tests
**/*.md
