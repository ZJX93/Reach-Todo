# 复制为 .env 并按需修改；未设置 JWT_SECRET 时启动会自动生成随机密钥并持久化。
# —— 后端 ——
# 数据库连接：留空默认使用 SQLite（backend/goalflow.db）
DATABASE_URL=sqlite+aiosqlite:///./goalflow.db
# 生产环境务必显式设置强随机密钥（否则任何人可伪造 token）
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# 允许的前端源，逗号分隔
CORS_ORIGINS=http://localhost:5173
# 是否自动播种演示账号 demo/reach2024（SQLite 发布版默认开；PostgreSQL 需显式置 1）
SEED_DEMO_ACCOUNT=1

# —— 以下为 Docker Compose 覆盖用 ——
# POSTGRES_DB=goalflow
# POSTGRES_USER=goalflow
# POSTGRES_PASSWORD=请改成强密码
